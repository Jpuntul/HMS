# Backend environment template.
# Copy to `back/.env` and fill in real values. NEVER commit the real .env.

# --- Server ---
PORT=8001
DEBUG=True

# Required when DEBUG=False. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Comma-separated hostnames. Required when DEBUG=False.
# Example: ALLOWED_HOSTS=hms.example.com,api.hms.example.com
ALLOWED_HOSTS=

# --- Database (MySQL) ---
DB_NAME=hms_db
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
# Path to a CA cert file, for managed hosts that require TLS (Aiven,
# PlanetScale, etc.). Leave empty for local/unencrypted MySQL.
# DB_SSL_CA=/path/to/ca.pem

# --- CORS ---
# Comma-separated origins allowed to call this API. Required in non-DEBUG envs.
# In DEBUG mode, defaults to localhost:5173/5174.
# Example: CORS_ALLOWED_ORIGINS=https://app.hms.example.com
CORS_ALLOWED_ORIGINS=

# --- Cookie security (optional overrides) ---
# Default: auto-enabled when DEBUG=False. Force off by setting to False.
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# --- Transport security (production) ---
# Both default ON when DEBUG=False.
# Set SECURE_SSL_REDIRECT=False only if something upstream already redirects,
# or you'll get a redirect loop.
# SECURE_SSL_REDIRECT=True
#
# Enable when running behind a TLS-terminating proxy or load balancer that
# sets X-Forwarded-Proto (most PaaS platforms do). Without it, SECURE_SSL_REDIRECT
# sees "http" on every request and redirects forever.
# USE_X_FORWARDED_PROTO=True
#
# Starts at 1 hour. Raise to 31536000 (1 year) only once HTTPS is confirmed
# working end to end - browsers cache this and it cannot be undone early.
# SECURE_HSTS_SECONDS=3600

# --- Logging ---
# Root log level. Defaults to DEBUG when DEBUG=True, otherwise INFO.
# LOG_LEVEL=INFO
#
# Set to DEBUG to print every SQL query the ORM runs - useful for hunting N+1s
# locally, far too noisy for production.
# SQL_LOG_LEVEL=WARNING

# --- Error tracking (optional) ---
# Leave empty to disable Sentry entirely. No account needed for local dev or CI.
SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# Fraction of requests traced for performance data (0.0-1.0).
# SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Server (production) ---
# Injected automatically by most hosting platforms; the container falls back
# to 8000. Number of gunicorn worker processes: start at 2.
# WEB_CONCURRENCY=2
